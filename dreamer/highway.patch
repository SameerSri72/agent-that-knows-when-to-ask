+"""
+highway-env wrapper for r2dreamer (DreamerV3).
+
+Translates highway-env into the format r2dreamer's environments use:
+- observations are a dictionary: {"vector": 25 numbers, "is_first", "is_last", "is_terminal"}
+- step() returns (obs, reward, done, info)
+- the action is an integer 0..4 (r2dreamer's OneHotAction wrapper converts
+  Dreamer's one-hot action vector to this integer)
+
+Episode endings:
+- a crash ends the episode with is_terminal=True  (no future reward exists)
+- the time limit ends it with is_terminal=False   (the future would have continued)
+Dreamer's continue head learns from this difference, so it matters.
+"""
+import gymnasium as gym
+import numpy as np
+
+
+class Highway(gym.Env):
+    metadata = {}
+
+    def __init__(self, task="fast", seed=0):
+        import highway_env  # noqa: F401  (registers the highway environments)
+
+        env_id = {"fast": "highway-fast-v0", "v0": "highway-v0"}[task]
+        self._env = gym.make(env_id)
+        self._seed = seed
+        self._first_reset = True
+        self.reward_range = [-np.inf, np.inf]
+
+    @property
+    def observation_space(self):
+        shape = (int(np.prod(self._env.observation_space.shape)),)  # (5, 5) -> (25,)
+        return gym.spaces.Dict({"vector": gym.spaces.Box(-np.inf, np.inf, shape, dtype=np.float32)})
+
+    @property
+    def action_space(self):
+        return gym.spaces.Discrete(int(self._env.action_space.n))  # 5 actions
+
+    def reset(self):
+        # Seed only the first reset; later resets continue the same random stream,
+        # so every training episode gets different traffic.
+        if self._first_reset:
+            obs, _ = self._env.reset(seed=self._seed)
+            self._first_reset = False
+        else:
+            obs, _ = self._env.reset()
+        return {
+            "vector": obs.reshape(-1).astype(np.float32),
+            "is_first": True,
+            "is_last": False,
+            "is_terminal": False,
+        }
+
+    def step(self, action):
+        obs, reward, terminated, truncated, info = self._env.step(int(action))
+        done = bool(terminated or truncated)
+        info = dict(info)
+        info["discount"] = np.array(0.0 if terminated else 1.0, np.float32)
+        return (
+            {
+                "vector": obs.reshape(-1).astype(np.float32),
+                "is_first": False,
+                "is_last": done,
+                "is_terminal": bool(terminated),
+            },
+            np.float32(reward),
+            done,
+            info,
+        )
+
+    def render(self):
+        return self._env.render()
+
+    def close(self):
+        self._env.close()

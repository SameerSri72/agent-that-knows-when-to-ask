+# highway-fast-v0: 25-number observations, 5 discrete actions, episodes of at most 30 decisions.
+# Light settings for an 8 GB laptop GPU.
+task: highway_fast
+steps: 5e4               # same training budget as the DQN/PPO baselines
+env_num: 1               # one simulator (one worker process)
+eval_episode_num: 1      # one evaluation simulator
+action_repeat: 1
+train_ratio: 64          # lower than DMC's 512 so the GPU is not saturated
+time_limit: 1000         # safety net only; highway ends episodes itself after 30 decisions
+
+seed: ${seed}
+device: ${device}
+
+size: [64, 64]           # unused (no images), kept because the code expects the key
+encoder:
+  mlp_keys: 'vector'
+  cnn_keys: '$^'
+decoder:
+  mlp_keys: 'vector'
+  cnn_keys: '$^'
